APP_ENV=development
APP_NAME=Gaas
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_VERIFY=false
DATABASE_CREATE_TABLES=false
DATABASE_STATEMENT_CACHE_SIZE=0
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://redis:6379/0

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET_KEY=not-used-with-supabase-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

TMDB_API_KEY=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
